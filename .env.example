# MAGI node configuration. Copy to .env and edit (setup_env.sh does this).
# Every value here has a default in magi/config.py; this file lists only what
# you are most likely to change.
#
# Advisors, models and prompts are NOT here — they live in config/magi.yaml,
# because rotating them is the point of the project rather than an edge case.

# ── Inference ────────────────────────────────────────────────────────────────
# The DGX Spark. DHCP, so this moves with the network:
#   2026-08-11, current WiFi:  192.168.68.121   (MacBook: 192.168.68.117)
#   previous WiFi:             192.168.18.52
MAGI_OLLAMA_HOST=192.168.68.121
MAGI_OLLAMA_PORT=11434

# `ollama` in the field and on the LAN; `openai` to work with the Spark powered
# off. Same AutoGen client class either way — only base_url and key change.
MAGI_LLM_BACKEND=ollama
# MAGI_OPENAI_BASE_URL=https://api.openai.com/v1
# MAGI_OPENAI_API_KEY=

# ── Debate ───────────────────────────────────────────────────────────────────
# autogen_roundrobin: deterministic turns, no speaker-selection LLM call.
# autogen_selector:   an LLM picks the next speaker — the thing being measured.
MAGI_ENGINE=autogen_roundrobin
MAGI_MAX_ROUNDS=3
MAGI_DEBATE_TIMEOUT_S=180
# MAGI_PERSONAS_FILE=config/magi.yaml

# ── Speech ───────────────────────────────────────────────────────────────────
MAGI_STT_MODEL=small
MAGI_STT_CPU_THREADS=4
MAGI_STT_PRELOAD=1

# Path to a Piper .onnx voice (the matching .onnx.json must sit beside it).
# Leave empty and the node shows verdicts without speaking them.
MAGI_TTS_ENABLED=1
MAGI_TTS_VOICE=

# ── Observability ────────────────────────────────────────────────────────────
# The collector is not the Spark: `./docker/compose.sh up` runs Jaeger on the
# dev machine, which on this network is 192.168.68.117.
MAGI_OTEL_ENABLED=1
MAGI_OTEL_EXPORTER=otlp
MAGI_OTEL_ENDPOINT=http://192.168.68.117:4318
# Must differ from the sibling repo's service name, or the two implementations'
# traces merge into one service and stop being comparable.
MAGI_OTEL_SERVICE_NAME=magi-autogen

# Tracing costs CPU and memory on the node whose CPU and memory are being
# measured. Set MAGI_OTEL_ENABLED=0 for benchmark runs — and set the sibling
# repo the same way, or the comparison is invalid.

# ── Misc ─────────────────────────────────────────────────────────────────────
MAGI_UI_PORT=8000
# 1 on the MacBook: disables Pi-specific services.
MAGI_FAKE_HW=0
MAGI_LOG_LEVEL=INFO
